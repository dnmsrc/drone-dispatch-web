# ─────────────────────────────────────────────────────────────
# 环境变量 · 公共默认（所有模式都会加载，提交进 Git）
#
# Vite 加载顺序（后者覆盖前者的同名 key）：
#   .env  →  .env.[mode]  →  .env.local  →  .env.[mode].local
# 其中 *.local 已被 .gitignore 忽略（*.local 规则），用于本机私有覆盖，不进 Git。
#
# 命名约定（重要）：
#   VITE_ 前缀  → 会被打包进客户端产物，浏览器代码经 import.meta.env 读取
#   无 VITE_ 前缀 → 仅在构建 / Node 侧（vite.config.ts）可用，不会进产物
# 因此密钥、数据库口令等敏感信息【绝不能】加 VITE_ 前缀，也不应放进前端仓库。
# ─────────────────────────────────────────────────────────────

# ===== 客户端变量（VITE_ 前缀，打进产物）=====

# 应用品牌名（登录页 / 页脚等品牌展示位使用）
VITE_APP_NAME=星穹 SkyShow

# 管理后台标题（侧边栏 Logo 文字、浏览器标签页标题、index.html 初始标题）
VITE_APP_TITLE=星穹派单管理后台

# 后端接口基础地址（请求层发起 HTTP 的统一前缀；当前后端所有接口都在 /api 下）
VITE_API_BASE_URL=/api

# 请求超时时间（毫秒），供后续接入的统一请求层使用
VITE_API_TIMEOUT=15000

# 是否注册「组件测试场」dev 路由与菜单（开发开、生产关）
VITE_ENABLE_DEV_PANEL=false

# ===== 构建 / Node 侧变量（无 VITE_ 前缀，仅 vite.config.ts 使用）=====

# 构建期主题名，对应 src/styles/themes/ 下的文件夹名（构建期换肤，详见该目录 README）
APP_THEME=default

# vite dev server 监听端口（strictPort 下端口被占用会直接报错，不会自动顺延）
DEV_SERVER_PORT=8091

# 开发代理目标：dev 下把 /api 前缀的请求转发到本地后端 drone-dispatch-server（端口 8080）
DEV_PROXY_TARGET=http://localhost:8080
